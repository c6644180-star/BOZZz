# Copy this file to backend/.env and fill in your own values.
# backend/.env is gitignored. Never commit real credentials.

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional overrides (defaults shown).
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# BOZZ_TTS_CHUNK_CHARS=500
# BOZZ_TTS_MAX_TOTAL_CHARS=4000
# BOZZ_TTS_TIMEOUT_SECONDS=45

# Gesture-driven desktop mouse (OFF until enabled in the UI).
# BOZZ_DESKTOP_MIN_CONFIDENCE=0.7
# BOZZ_DESKTOP_RATE_LIMIT=60
# BOZZ_DESKTOP_AREA=0.8
# BOZZ_DESKTOP_EDGE_MARGIN=12
# BOZZ_DESKTOP_HOTKEY=<ctrl>+<alt>+q
