{
  "version": 1,
  "defaults": {
    "enabled": false,
    "approval_mode": "every_step",
    "ask_new_domain": true,
    "screenshot_to_provider": false,
    "dry_run": true,
    "max_steps": 25,
    "max_seconds": 300,
    "approval_timeout_seconds": 30
  },
  "domains": [
    "youtube.com",
    "www.youtube.com",
    "wikipedia.org",
    "www.wikipedia.org"
  ],
  "test_site": {
    "hosts": ["127.0.0.1", "localhost"],
    "path_prefix": "/agent/test-site",
    "label": "BOZZ test site"
  },
  "window": {
    "headed": true,
    "profile_dirname": "agent-profile",
    "screenshots_dirname": "agent-screenshots",
    "downloads_dirname": "agent-downloads",
    "observation_chars": 6000
  },
  "actions": [
    { "id": "browser.open", "tier": 1, "label": "Open an allowlisted page", "risk": "low" },
    { "id": "browser.search", "tier": 1, "label": "Search the current page", "risk": "low" },
    { "id": "browser.scroll", "tier": 1, "label": "Scroll the page", "risk": "low" },
    { "id": "browser.read_text", "tier": 1, "label": "Read page text", "risk": "low" },
    { "id": "browser.inspect", "tier": 1, "label": "Inspect the page", "risk": "low" },
    { "id": "browser.verify", "tier": 1, "label": "Verify an observed page result", "risk": "low" },
    { "id": "browser.wait", "tier": 1, "label": "Wait for the page to update", "risk": "low" },
    { "id": "browser.screenshot", "tier": 1, "label": "Save a screenshot of the agent browser", "risk": "low" },
    { "id": "browser.close", "tier": 1, "label": "Close the agent browser", "risk": "low" },
    { "id": "browser.click_link", "tier": 1, "label": "Open a link on the current page", "risk": "low" },
    { "id": "browser.dismiss_consent", "tier": 1, "label": "Decline or close a cookie banner", "risk": "low" },
    { "id": "browser.type", "tier": 2, "label": "Type into a form field", "risk": "medium" },
    { "id": "browser.click", "tier": 2, "label": "Click a button that submits", "risk": "medium" },
    { "id": "browser.download", "tier": 2, "label": "Download a file", "risk": "medium" },
    { "id": "browser.upload", "tier": 2, "label": "Upload a file you picked", "risk": "medium" },
    { "id": "app.launch", "tier": 2, "label": "Open an allowlisted app", "risk": "medium" },
